# Copy to ~/.pi/agent/.env (install.sh does this if missing)
# Never commit the real .env — it holds secrets.

# Strict round-robin: (active+1) % N on every request; no error-driven double-rotation
XOT_STRICT_ROTATE=1

# Optional: set PI_OFFLINE=1 if you rotate keys only via xot (no single static OPENROUTER_API_KEY)
# PI_OFFLINE=1

# Optional host-specific (add your own):
# NOTION_API_KEY=
# NOTION_PARENT_PAGE=
# TG_BOT_TOKEN=
# TG_CHAT_ID=
